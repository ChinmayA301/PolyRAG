# Copy to .env and fill in. Every provider below has a free tier / free local option.

# Groq (free tier) — serves the default models: llama, gpt-oss, qwen, scout.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# OpenRouter (free tier) — lights up the `deepseek` alias (deepseek/deepseek-r1:free).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Ollama (no key needed). Install: https://ollama.com, then `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings: sentence-transformers/all-MiniLM-L6-v2 by default, device auto-detected
# (CUDA > Apple MPS > CPU). Override to pin:
# EMBED_DEVICE=cpu
