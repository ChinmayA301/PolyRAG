# Copy to .env and fill in only the providers you intend to use.

# Groq — serves gpt-oss, gpt-oss-20b, and qwen-3.6.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# OpenRouter — lights up the optional `nemotron` free route.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub Models — lights up `deepseek`, `deepseek-r1`, and `gpt-4.1-mini`.
# Use a dedicated, minimally scoped PAT with models:read. Do not deploy a
# general-purpose gh CLI token that also grants repository access.
GITHUB_TOKEN=

# Local Ollama (no key needed). Install: https://ollama.com, then `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ENABLED=false

# Embeddings: sentence-transformers/all-MiniLM-L6-v2 by default, device auto-detected
# (CUDA > Apple MPS > CPU). Override to pin:
# EMBED_DEVICE=cpu
